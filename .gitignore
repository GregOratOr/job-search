# ── Generated outputs (rebuild from per-job .py sources) ────────────────────
resume/outputs/*
!resume/outputs/*.py
coverletter/outputs/*
!coverletter/outputs/*.py

# Keep .py sources and the output directories themselves
!resume/outputs/.gitkeep
!coverletter/outputs/.gitkeep

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.Python
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
venv/
env/
.env

# ── Secrets ──────────────────────────────────────────────────────────────────
.env
*.secret
secrets.yaml

# ── OS & Editor ──────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# ── Signature image (keep local, don't commit personal files) ────────────────
signature.png
signature.jpg

# ── Personal documents & working notes (never commit) ───────────────────────


# Real application bundles stay private — only the template ships publicly.
applications/jobs/*
!applications/jobs/_template/


# ── Editor / IDE ──────────────────────────────────────────────────────────────
.cursor/
.vscode/

# ── Networking CSV (contains personal contact info — review before sharing) ──
# Template versions are committed; your real connections live in private/networking/
networking/connections.csv

