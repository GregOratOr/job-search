# .env.example
# Copy this to .env and fill in your values.
# .env is gitignored — never commit real keys.

# ── LLM provider (ai_tailor.py, audit.py, job_discovery.py, ...) ─────────────
# anthropic | ollama | openai
# LLM_PROVIDER=ollama

# ── Models — configured HERE, not in code ─────────────────────────────────────
# There are no hardcoded model names in the scripts. Resolution order:
#   0. Explicit --model / model= argument (wins immediately)
#   1. LLM_MODEL_<TASK>   (only with --use-agent; see below)
#   2. LLM_MODEL          (global default for the active provider)
#   3. Provider variable  (OLLAMA_MODEL | ANTHROPIC_MODEL | OPENAI_MODEL)
# If none is set, the script exits and asks you to configure one.

# Global default model for the active provider
# LLM_MODEL=qwen3.6:27b-q4_K_M

# Per-task model overrides (optional). Used only when you pass --use-agent.
# Useful to pin a stronger model for audit/tailoring while keeping a cheap local
# model for discovery/follow-ups in agent mode.
# LLM_MODEL_TAILOR=claude-opus-4-7      # ai_tailor.py (resume/CL/outreach generation)
# LLM_MODEL_AUDIT=claude-opus-4-7       # audit.py (pre-submit critique)
# LLM_MODEL_RESEARCH=qwen3.6:27b-q4_K_M # research.py (company/topic briefs)
# LLM_MODEL_DISCOVERY=qwen3.6:27b-q4_K_M# job_discovery.py (search + ranking)
# LLM_MODEL_FOLLOWUP=qwen3.6:27b-q4_K_M # followup.py (follow-up drafts)

# ── Anthropic (cloud) ─────────────────────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-4-7

# ── Ollama (local, OpenAI-compatible — no agent harness required) ─────────────
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen3.6:27b-q4_K_M
OLLAMA_API_KEY=ollama

# ── OpenAI-compatible (OpenAI, LM Studio, vLLM, etc.) ───────────────────────
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# ── Web access (scripts/web.py — fallback when harness has no native web) ───
# Only needed for standalone/scripted runs. Agent harnesses with built-in
# web search/extraction should use those tools directly (see skills + okf/).
# REQUIRED for scripted web I/O — there is no implicit default. Pick one:
# searxng | tavily | brave | serper | harness
# WEB_BACKEND=searxng

# ── Harness web adapters (WEB_BACKEND=harness) ───────────────────────────────
# Subprocess commands invoked by scripts/web.py when backend=harness.
# Each command receives one extra argument (query or URL) appended to the command.
# Wire these to thin wrappers around your harness's native web_search / web_extract.
# HARNESS_WEB_SEARCH_CMD=your-harness-search-adapter
# HARNESS_WEB_FETCH_CMD=your-harness-fetch-adapter
# SEARXNG_URL=http://127.0.0.1:8888
# SEARXNG_CATEGORIES=general            # optional, comma-separated

# Optional hosted search APIs (only needed for the matching WEB_BACKEND)
# TAVILY_API_KEY=tvly-...
# BRAVE_API_KEY=...
# SERPER_API_KEY=...

# ── Optional contact enrichment (scripts/find_contacts.py) ───────────────────
# Off by default. Only Hunter is implemented. Requires --domain on the CLI too.
# ENRICHMENT_PROVIDER=hunter
# HUNTER_API_KEY=...
